# The following fields are used to identify the programs used.

_computing_data_collection        'DMS software (Scintag Inc., 1994)'
_computing_cell_refinement        'CSD (Akselrud et al., 1993)'
_computing_data_reduction         'CSD'
_computing_structure_solution     'CSD'
_computing_structure_refinement   'CSD'
