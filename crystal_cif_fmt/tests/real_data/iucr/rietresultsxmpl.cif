# 6. POWDER SPECIMEN AND CRYSTAL DATA

_space_group_crystal_system             trigonal      
_space_group_name_H-M_alt               'P -3 m 1'
_space_group_name_Hall                  '-P 3 2"'

loop_                                            
    _symmetry_equiv_pos_site_id
    _symmetry_equiv_pos_as_xyz
    1    x,y,z
    2    -y,x-y,z
    3    -x+y,-x,z
    4    -y,-x,z
    5    -x+y,y,z
    6    x,x-y,z
    7    -x,-y,-z
    8    y,-x+y,-z
    9    x-y,x,-z
   10    y,x,-z
   11    x-y,-y,-z
   12    -x,-x+y,-z

