# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# rushi session traces
sessions


# Added by cargo

/target
*.cell

# dict-items orchestration (worktrees, state, logs, task files are tracked; runtime state is not)
.worktrees/
orchestrate/logs/
orchestrate/pids/
orchestrate/tmp/
orchestrate/STATE
orchestrate/HOLD
orchestrate/PID
orchestrate/PID
orchestrate/PID_SHELL

# cif_api corpus: the CIFs are fetched at test time (CI and locally)
# by tests/real_data/cif_api/fetch.py from a pinned upstream commit.
# The expected JSON pins in tests/real_data/expected/ are committed.
tests/real_data/cif_api/*.cif
